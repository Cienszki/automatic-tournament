# ─── Firebase Client SDK (baked into the browser bundle at build time) ─────────
# Copy this file to .env.local and fill in the real values.
# Get these from: Firebase Console → Project Settings → Your apps → Web app → Config

NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# ─── Firebase Admin SDK (server-side only, never sent to the browser) ──────────
# Base64-encoded service account JSON.
# Generate: Firebase Console → Project Settings → Service accounts → Generate new private key
# Encode:   node -e "process.stdout.write(require('fs').readFileSync('service-account.json').toString('base64'))"

FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ...
# ─── Steam API (server-side only) ──────────────────────────────────────────────
# Get from: https://steamcommunity.com/dev/apikey
# Used for resolving Steam vanity URLs and syncing matches.

STEAM_API_KEY=your-steam-api-key

# ─── Rules assistant (Gemini, server-side only) ────────────────────────────────
# Get a key from: https://aistudio.google.com/apikey (free tier is enough).
# Without it the "Zapytaj o regulamin" widget stays hidden.
GEMINI_API_KEY=
# Optional: model override (default gemini-3.5-flash-lite).
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: usage caps — keep the global ones under the free-tier limits shown in AI Studio.
# RULES_AI_GLOBAL_PER_MINUTE=10
# RULES_AI_GLOBAL_PER_DAY=500
# RULES_AI_USER_PER_HOUR=10
# RULES_AI_USER_PER_DAY=30