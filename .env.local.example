# Settings for running the web app on this machine. docs/DEV_SETUP.md explains each environment.
#
# You do not need this file for `npm run db:seed` and `npm run dev:local`: those set everything
# themselves and blank every value from .env files, so nothing here can reach a local run.
#
# Copy it to `.env.local` (git-ignored) only for a plain `npm run dev` or `npm run build`, and fill
# it with STAGING values (docs/overhaul/SETUP_STAGING.md), never production ones: a local build
# with production credentials once read production data. Blank means off.

# --- The site's own address (src/platform/origins) ---
# Public address, used in links, the sitemap and metadata. Blank: http://localhost:<PORT>.
NEXT_PUBLIC_SITE_URL=
# More origins allowed to post to us, comma-separated (a www. variant, the host's own address).
ALLOWED_ORIGINS=
# Absolute origin for /_next files, only when a proxy in front owns /_next. Blank: relative paths.
NEXT_PUBLIC_ASSET_ORIGIN=

# --- Database (new platform) ---
# postgres://... for a PostgreSQL server, pglite:<folder> for a local PGlite folder.
# Blank: pages that read the database show nothing from it.
DATABASE_URL=
# Connections per server process. Default 5.
DATABASE_POOL_MAX=

# --- Firebase web app (sign-in and files). Required by the build; not secret. ---
# Firebase console -> Project settings -> Your apps -> Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only, secret). Leave blank on this machine. ---
# Base64 of a service-account key. With it, server code acts as the project's administrator.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- Other services (server only, secret). Blank: the feature that needs one is off. ---
STEAM_API_KEY=
OPENDOTA_API_KEY=
STRATZ_API_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_BOT_CLIENT_ID=
TWITCH_CLIENT_ID=
TWITCH_TOKEN=
BUNNY_STREAM_API_KEY=
# Shared secret of scheduled calls, and of the signed "turn off" links in notifications.
CRON_SECRET=
NOTIFY_SECRET=

# --- Rules assistant (Gemini). Blank: the "Zapytaj o regulamin" widget stays hidden. ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# RULES_AI_GLOBAL_PER_MINUTE=10
# RULES_AI_GLOBAL_PER_DAY=500
# RULES_AI_USER_PER_HOUR=10
# RULES_AI_USER_PER_DAY=30

# --- Error monitoring and alerts. Blank: off, and the build makes no network call. ---
SENTRY_DSN_WEB=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
SENTRY_AUTH_TOKEN=
ALERT_DISCORD_WEBHOOK_URL=
# LOG_LEVEL=info
