# Staging values for the new platform.
# Copy this file to `.env.staging.local` (same folder) and fill it in.
# `.env.staging.local` is git-ignored. Never commit it and never paste its values into a chat.
# The steps for finding each value are in docs/overhaul/SETUP_STAGING.md.

# --- Supabase (step 1) ---
# "Transaction pooler" string, port 6543. Used by the web app.
DATABASE_URL=
# "Session pooler" string, port 5432. Used for migrations and by the bot.
DATABASE_URL_SESSION=

# --- Firebase staging project (step 2) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- Discord application "staging" (step 4) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Error monitoring and alerts (step 5, can wait) ---
# Server DSN of the Sentry project tournament-web. Blank: Sentry is not started.
SENTRY_DSN_WEB=
# Browser DSN, usually the same value as SENTRY_DSN_WEB. Inlined at build time.
NEXT_PUBLIC_SENTRY_DSN=
# Share of requests traced, 0 to 1. Blank means 0 (no tracing).
SENTRY_TRACES_SAMPLE_RATE=
# Same for the browser, inlined at build time. Blank means 0.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Build only: lets the build create the release and upload source maps. Blank: no upload, no network call.
SENTRY_AUTH_TOKEN=
# DSN of the Sentry project for the bot (used from WP-22).
SENTRY_DSN_BOT=
# Discord webhook of the private alert channel. Blank: alerts are not sent.
ALERT_DISCORD_WEBHOOK_URL=

# --- Made up by us; any long random text ---
CRON_SECRET=
