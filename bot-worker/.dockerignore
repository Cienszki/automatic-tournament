# Never put secrets or local overrides in the image
.env
*.env.local
*.env.*.local

# Installed and built inside the image (npm ci, tsc), never copied from the host
node_modules
dist

# Logs
*.log

# Windows/macOS junk
Thumbs.db
.DS_Store

