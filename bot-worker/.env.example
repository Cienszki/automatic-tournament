# bot-worker/.env — copy to bot-worker/.env and fill in. GITIGNORED (never committed).
# Only needed to run the bot / test harnesses LOCALLY. On Railway these come from the
# service's environment variables instead (and the Dockerfile never copies .env).

# REQUIRED — base64 of the Firebase service account JSON (same value as the root app's
# FIREBASE_SERVICE_ACCOUNT_BASE64). Used by dist/firebase.js to reach Firestore.
# Generate:  base64 -w0 serviceAccount.json     (or on Windows PowerShell:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccount.json")) )
FIREBASE_SERVICE_ACCOUNT_BASE64=

# OPTIONAL — only for `node dist/diagnose.js` / harnesses WITHOUT --bot-id (creds from .env
# instead of Firestore botAccounts). Normally you pass --bot-id=<id> and leave these blank.
STEAM_USERNAME=
STEAM_PASSWORD=
STEAM_GUARD_SHARED_SECRET=

# OPTIONAL — legacy / tuning knobs (safe defaults if omitted).
BOT_ACCOUNT_ID=
POLL_INTERVAL_MS=
HEARTBEAT_INTERVAL_MS=
LOG_LEVEL=info
