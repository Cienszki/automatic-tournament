{
  "name": "bot-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Dota 2 lobby bot worker for the tournament platform",
  "main": "dist/conductor.js",
  "scripts": {
    "start": "node dist/conductor.js",
    "conductor": "node dist/conductor.js",
    "runner": "node dist/runner.js",
    "discord": "node dist/discord-gateway.js",
    "setup:local": "node setup-local.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dota2": "7.0.3",
    "dotenv": "16.6.1",
    "firebase-admin": "12.7.0",
    "steam": "1.4.1",
    "steam-totp": "2.1.2",
    "steam-user": "5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
