rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /screenshots/{teamId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /team-logos/{fileName} {
      allow read: if true; // Public read for team logos (displayed on public pages)
      allow write: if request.auth != null; // Authenticated users can upload (admin check done in app)
    }
    match /standin-screenshots/{fileName} {
      allow read: if true; // Allow public read for standin screenshots (for admin verification)
      allow write: if request.auth != null; // Allow authenticated users to upload their standin screenshots
    }
    match /tournament-assets/{slug}/{allFiles=**} {
      allow read: if true; // Public read — logos/backgrounds displayed on public tournament pages
      allow write: if request.auth != null; // Authenticated users can upload (admin check in app)
    }
    match /tournaments/{tournamentId}/divisions/{divisionId}/{fileName} {
      allow read: if true; // Public read for division medals (displayed on public pages)
      allow write: if request.auth != null; // Authenticated users can upload (admin check done in app)
    }
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }
  }
}
